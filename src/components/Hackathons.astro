---
import { getCollection } from "astro:content";
import { formatDateRange, t, type Locale } from "../i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale);
const hackathonEntries = await getCollection(
  "hackathons",
  ({ data }) => data.lang === locale,
);

// Sort by start date, most recent first
const sortedHackathons = hackathonEntries.sort(
  (a, b) => b.data.startDate.getTime() - a.data.startDate.getTime()
);

---

<section id="hackathons" class="py-20 px-4">
  <div class="max-w-4xl mx-auto">
    <div class="text-center mb-12">
      <h2 class="text-4xl font-bold mb-4">{copy.sections.hackathons.title}</h2>
      <p class="text-lg text-base-content/70">
        {copy.sections.hackathons.subtitle}
      </p>
    </div>

    <div class="space-y-6">
      {
        sortedHackathons.map((hackathon) => (
          <div class="card bg-base-100 shadow-xl hover:shadow-2xl transition-shadow">
            <div class="card-body">
              <div class="flex items-start gap-4">
                {hackathon.data.logo && (
                  <div class="avatar flex-shrink-0">
                    <div class="w-16 h-16 rounded">
                      <img
                        src={hackathon.data.logo}
                        alt={hackathon.data.title}
                      />
                    </div>
                  </div>
                )}
                <div class="flex-1">
                  <time class="text-sm text-base-content/60">
                    {formatDateRange(
                      hackathon.data.startDate,
                      hackathon.data.endDate,
                      locale
                    )}
                  </time>
                  <h3 class="card-title mt-1">{hackathon.data.title}</h3>
                  <p class="text-sm text-primary font-semibold">
                    {hackathon.data.location}
                  </p>
                  <p class="text-base-content/80 mt-3">
                    {hackathon.data.description}
                  </p>
                  {hackathon.data.sourceLink && (
                    <div class="card-actions mt-4">
                      <a
                        href={hackathon.data.sourceLink}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn btn-sm btn-outline btn-primary"
                      >
                        {copy.actions.viewProject}
                      </a>
                    </div>
                  )}
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
