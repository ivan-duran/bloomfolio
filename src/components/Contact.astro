---
import { MessageCircleCode } from "@lucide/astro";
import { siteConfig } from "../config";
---

<footer class="footer footer-horizontal footer-center bg-base-200 py-10">
  <aside>
    <MessageCircleCode class="inline-block size-20" />
    <p class="max-w-xl m-auto text-lg">
      ¿Quieres charlar? Envíame un correo a <a
        href={`mailto:${siteConfig.email}`}
        class="link link-hover text-primary"
        >{siteConfig.email}</a
      > o contáctame por <a
        href={siteConfig.socialLinks.linkedin}
        target="_blank"
        class="link link-hover text-primary"
        >LinkedIn</a
      > y te responderé lo antes posible.
    </p>
  </aside>
</footer>
