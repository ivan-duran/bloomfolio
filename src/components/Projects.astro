---
import { getCollection } from "astro:content";
import ProjectCard from "./ProjectCard.astro";
import { t, type Locale } from "../i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale);
const projectEntries = await getCollection(
  "projects",
  ({ data }) => data.lang === locale,
);

// Sort by start date, most recent first
const sortedProjects = projectEntries.sort(
  (a, b) => b.data.startDate.getTime() - a.data.startDate.getTime()
);
---

<section id="projects" class="py-20 px-4 bg-base-200">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-12">
      <h2 class="text-4xl font-bold mb-4">{copy.sections.projects.title}</h2>
      <p class="text-lg text-base-content/70">
        {copy.sections.projects.subtitle}
      </p>
    </div>

    <div
      class="grid gap-6 justify-items-center w-full [grid-template-columns:repeat(auto-fit,minmax(280px,1fr))]"
    >      
    {sortedProjects.map((project) => (
        <ProjectCard project={project} locale={locale} />
      ))}
    </div>
  </div>
</section>
