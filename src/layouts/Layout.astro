---
import "../styles/global.css";
import ThemeToggle from "../components/ThemeToggle.astro";
import ThemeSelector from "../components/ThemeSelector.astro";
import LanguageToggle from "../components/LanguageToggle.astro";
import FabFlower from "../components/FabFlower.astro";
import { ClientRouter } from "astro:transitions";
import { siteConfig } from "../config";
import {
  defaultLocale,
  getLocaleFromPathname,
  localizePath,
  locales,
  ogLocales,
  t,
  type Locale,
} from "../i18n";

interface Props {
  title?: string;
  description?: string;
  locale?: Locale;
  alternatePaths?: Partial<Record<Locale, string>>;
}

const {
  locale = getLocaleFromPathname(Astro.url.pathname),
  title = t(locale).site.defaultTitle,
  description = t(locale).site.defaultDescription,
  alternatePaths,
} = Astro.props;

// Custom blur-fade animation configuration
const blurFadeAnimation = {
  old: {
    name: "blurFadeOut",
    duration: "0.3s",
    easing: "ease-in-out",
    fillMode: "forwards",
  },
  new: {
    name: "blurFadeIn",
    duration: "0.3s",
    easing: "ease-in-out",
    fillMode: "backwards",
  },
};

const pageTransition = {
  forwards: blurFadeAnimation,
  backwards: blurFadeAnimation,
};

const origin = Astro.url.origin;
const currentPathname = Astro.url.pathname;
const resolvedAlternatePaths =
  alternatePaths ??
  Object.fromEntries(
    locales.map((alternateLocale) => [
      alternateLocale,
      localizePath(currentPathname, alternateLocale),
    ]),
  );
const canonicalPath = resolvedAlternatePaths[locale] ?? localizePath(currentPathname, locale);
const canonicalUrl = new URL(canonicalPath, origin).toString();
---

<!doctype html>
<html lang={locale} data-language={locale} transition:animate={pageTransition}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {
      locales.map((alternateLocale) => {
        const alternatePath = resolvedAlternatePaths[alternateLocale];
        return (
          alternatePath && (
            <link
              rel="alternate"
              hreflang={alternateLocale}
              href={new URL(alternatePath, origin).toString()}
            />
          )
        );
      })
    }
    {
      resolvedAlternatePaths[defaultLocale] && (
        <link
          rel="alternate"
          hreflang="x-default"
          href={new URL(resolvedAlternatePaths[defaultLocale], origin).toString()}
        />
      )
    }
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- View Transitions -->
    <ClientRouter />

    <!-- Open Graph / Social Media -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={ogLocales[locale]} />
    <meta property="og:image" content={`${origin}/images/og_home.png`} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${origin}/images/og_home.png`} />
  </head>
  <body class="min-h-screen">
    <!-- Controls - Fixed Position -->
    <div class="fixed top-4 right-4 z-50 flex items-center gap-3">
      <LanguageToggle locale={locale} pathname={currentPathname} />
      {siteConfig.enableThemeSelector ? <ThemeSelector /> : <ThemeToggle />}
    </div>

    <slot />

    {
      siteConfig.extraLinks.enable && (
        <FabFlower extraLinks={siteConfig.extraLinks} locale={locale} />
      )
    }

    <!-- Smooth Scroll -->
    <style is:global>
      html {
        scroll-behavior: smooth;
      }

      /* Initial Page Load Blur-Fade Animation */
      @keyframes pageLoadBlurFade {
        0% {
          opacity: 0;
          filter: blur(8px);
        }
        100% {
          opacity: 1;
          filter: blur(0px);
        }
      }

      html {
        animation: pageLoadBlurFade 0.3s ease-in-out;
        animation-fill-mode: both;
      }

      /* Blur Fade View Transitions (for page-to-page navigation) */
      @keyframes blurFadeIn {
        0% {
          opacity: 0;
          filter: blur(10px);
        }
        100% {
          opacity: 1;
          filter: blur(0px);
        }
      }

      @keyframes blurFadeOut {
        0% {
          opacity: 1;
          filter: blur(0px);
        }
        100% {
          opacity: 0;
          filter: blur(10px);
        }
      }
    </style>
  </body>
</html>
