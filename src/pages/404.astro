---
import Layout from "../layouts/Layout.astro";
import { House, FolderOpen } from "@lucide/astro";
import { getLocaleFromPathname, localizePath, t } from "../i18n";

const locale = getLocaleFromPathname(Astro.url.pathname);
const copy = t(locale);
---

<Layout
  locale={locale}
  title={`404 - ${copy.errors.notFoundTitle}`}
  description={copy.errors.notFoundDescription}
>
  <div class="min-h-screen flex items-center justify-center px-4 py-20">
    <div class="text-center max-w-2xl mx-auto">
      <!-- Large 404 Number -->
      <h1 class="text-9xl font-bold text-primary mb-4 animate-pulse">404</h1>

      <!-- Error Title -->
      <h2 class="text-4xl font-bold mb-4">{copy.errors.notFoundTitle}</h2>

      <!-- Error Description -->
      <p class="text-xl mb-8 text-base-content/70">
        {copy.errors.notFoundDescription}
      </p>

      <!-- Divider -->
      <div class="divider"></div>

      <!-- Action Buttons -->
      <div class="flex gap-4 justify-center flex-wrap mt-8">
        <a href={localizePath("/", locale)} class="btn btn-primary gap-2">
          <House class="size-5" />
          {copy.actions.goHome}
        </a>
        <a href={localizePath("/#projects", locale)} class="btn btn-outline gap-2">
          <FolderOpen class="size-5" />
          {copy.actions.viewProjects}
        </a>
      </div>

      <!-- Helpful Links -->
      <div class="flex justify-center gap-2 mt-12">
        <p class="text-sm text-base-content/60 mb-4">
          {copy.messages.lookingFor}
        </p>
        <div class="flex gap-3 justify-center flex-wrap text-sm">
          <a href={localizePath("/#about", locale)} class="link link-hover">About</a>
        </div>
      </div>
    </div>
  </div>
</Layout>
