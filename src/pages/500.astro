---
import Layout from "../layouts/Layout.astro";
import { House, ArrowLeft } from "@lucide/astro";
import { getLocaleFromPathname, localizePath, t } from "../i18n";

interface Props {
  error?: unknown;
}

const { error } = Astro.props;
const locale = getLocaleFromPathname(Astro.url.pathname);
const copy = t(locale);

// Sanitize error for display - NEVER expose sensitive server details in production
const displayMessage = copy.errors.serverDescription;

// Log full error server-side for debugging (only visible in server logs)
if (error instanceof Error) {
  console.error("500 Server Error:", {
    message: error.message,
    stack: error.stack,
    timestamp: new Date().toISOString(),
  });
}
---

<Layout
  locale={locale}
  title={`500 - ${copy.errors.serverTitle}`}
  description={copy.errors.serverDescription}
>
  <div class="min-h-screen flex items-center justify-center px-4 py-20">
    <div class="text-center max-w-2xl mx-auto">
      <!-- Large 500 Number -->
      <h1 class="text-9xl font-bold text-error mb-4 animate-pulse">500</h1>

      <!-- Error Title -->
      <h2 class="text-4xl font-bold mb-4">{copy.errors.serverTitle}</h2>

      <!-- Error Description -->
      <p class="text-xl mb-8 text-base-content/70">
        {displayMessage}
        <br />
        {copy.errors.serverTryAgain}
      </p>

      <!-- Divider -->
      <div class="divider"></div>

      <!-- Action Buttons -->
      <div class="flex gap-4 justify-center flex-wrap mt-8">
        <a href={localizePath("/", locale)} class="btn btn-primary gap-2">
          <House class="size-5" />
          {copy.actions.goHome}
        </a>
        <button onclick="history.back()" class="btn btn-outline gap-2">
          <ArrowLeft class="size-5" />
          {copy.actions.goBack}
        </button>
      </div>

      <!-- Note about SSR -->
      <div class="mt-12 p-4 bg-base-200 rounded-lg">
        <p class="text-sm text-base-content/60">
          <strong>Note:</strong> {copy.messages.serverNote}
        </p>
      </div>

      <!-- Helpful Links -->
      <div class="mt-8">
        <p class="text-sm text-base-content/60 mb-4">{copy.messages.needHelp}</p>
        <div class="flex gap-3 justify-center flex-wrap text-sm">
          <a href={localizePath("/#contact", locale)} class="link link-hover">
            {copy.labels.contact}
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>
