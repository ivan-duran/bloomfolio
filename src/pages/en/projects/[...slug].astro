---
import { render } from "astro:content";
import ProjectLayout from "../../../layouts/ProjectLayout.astro";
import {
  getEntryAlternatePaths,
  getLocalizedCollection,
} from "../../../i18n/content";
import type { Locale } from "../../../i18n";

export async function getStaticPaths() {
  const projectEntries = await getLocalizedCollection("projects", "en");

  return projectEntries.map((entry) => ({
    params: { slug: entry.data.routeSlug },
    props: { entry, locale: "en" },
  }));
}

const { entry, locale: localeProp } = Astro.props;
const locale = localeProp as Locale;
const { Content } = await render(entry);
const alternatePaths = await getEntryAlternatePaths(
  "projects",
  entry.data.routeSlug,
  (slug) => `/projects/${slug}`,
);
---

<ProjectLayout
  locale={locale}
  title={entry.data.title}
  description={entry.data.description}
  startDate={entry.data.startDate}
  endDate={entry.data.endDate}
  image={entry.data.image}
  skills={entry.data.skills}
  demoLink={entry.data.demoLink}
  sourceLink={entry.data.sourceLink}
  alternatePaths={alternatePaths}
>
  <Content />
</ProjectLayout>
